# Copy this file to `.env` (which is git-ignored) and fill in your own values.
#
# ⚠️ EXPO_PUBLIC_* values are compiled into the app bundle in PLAIN TEXT.
# Anyone with the APK can extract them. Use these for local development and
# personal prototypes only, with a low-limit key. See README → "API key security".
#
# You can also leave the keys empty here and paste them into the app at
# Settings → AI brain (stored in the phone's encrypted keystore).

# Which provider to use by default: openrouter | groq
EXPO_PUBLIC_AI_PROVIDER=openrouter

# --- OpenRouter (https://openrouter.ai/keys) ---
EXPO_PUBLIC_OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models
EXPO_PUBLIC_OPENROUTER_MODEL=
# Optional: point at your own backend proxy later (must speak /chat/completions)
EXPO_PUBLIC_OPENROUTER_BASE_URL=

# --- Groq (https://console.groq.com/keys) ---
EXPO_PUBLIC_GROQ_API_KEY=
# Any model id from https://console.groq.com/docs/models
EXPO_PUBLIC_GROQ_MODEL=
EXPO_PUBLIC_GROQ_BASE_URL=
